{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/sync-recipes-for-api.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "node scripts/sync-recipes-for-api.mjs && vitest run",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:coverage": "node scripts/sync-recipes-for-api.mjs && vitest run --coverage",
    "test:bundle-size": "node scripts/check-bundle-size.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:desktop": "playwright test --project=chromium",
    "lint": "eslint src api --report-unused-disable-directives --max-warnings 130",
    "lint:fix": "eslint src api --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "ci": "npm run lint && npm run type-check && npm run test:coverage && npm run build && npm run test:bundle-size",
    "images:dry-run": "node scripts/generate-imagen-images.mjs --dry-run --missing-only",
    "images:batch": "node scripts/generate-imagen-images.mjs --missing-only --limit 20",
    "images:resume": "node scripts/generate-imagen-images.mjs --missing-only --limit 20 --resume",
    "images:rebuild:fallback": "node scripts/rebuild-recipe-images.mjs --force-all --fallback-only --clean-old-generated",
    "images:generate:local": "node scripts/generate-recipe-derived-local-images.mjs",
    "images:apply:realistic-temp": "node scripts/apply-realistic-temporary-images.mjs && node scripts/sync-recipes-for-api.mjs",
    "images:verify": "node scripts/verify-recipe-images.mjs",
    "images:responsive": "node scripts/generate-responsive-images.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "verify:vercel-env": "node scripts/verify-vercel-env.mjs",
    "verify:storage": "node scripts/verify-storage.mjs",
    "enable:firebase-storage": "node scripts/enable-firebase-storage.mjs",
    "verify:ops": "node scripts/verify-ops.mjs",
    "deploy:firebase-rules": "node scripts/deploy-firebase-rules.mjs",
    "lighthouse:ci": "npx --yes @lhci/cli@0.14.0 autorun",
    "deploy": "node scripts/deploy-all.mjs",
    "deploy:prod": "node scripts/deploy-all.mjs",
    "backup:recipes": "node scripts/backup-recipes-json.mjs",
    "seed:recipes": "node scripts/seed-recipes-firestore.mjs",
    "set:archive-phone": "node scripts/set-archive-phone.mjs",
    "configure:text-to-gallery": "node scripts/configure-text-to-gallery.mjs",
    "configure:notify": "node scripts/configure-notify.mjs",
    "configure:sentry": "node scripts/configure-sentry.mjs",
    "configure:fcm": "node scripts/configure-fcm.mjs",
    "configure:firebase-web": "node scripts/configure-firebase-web.mjs",
    "configure:app-check": "node scripts/configure-app-check.mjs",
    "next-steps": "node scripts/run-next-steps.mjs",
    "productionize": "node scripts/productionize.mjs",
    "finalize": "node scripts/finalize-launch.mjs",
    "bootstrap:credentials": "node scripts/bootstrap-credentials.mjs",
    "custodian:runbook": "node scripts/custodian-runbook.mjs",
    "fix:gallery-uploads-env": "node scripts/fix-gallery-uploads-env.mjs",
    "vercel:env:pull": "vercel env pull .env.vercel.local --environment=production --yes",
    "normalize:contributors": "node scripts/normalize-contributor-names-firestore.mjs",
    "normalize:contributors:dry-run": "node scripts/normalize-contributor-names-firestore.mjs --dry-run",
    "admin:set-claim": "node scripts/set-admin-claim.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@sentry/react": "^10.72.0",
    "busboy": "^1.6.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "twilio": "^6.0.2",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vercel/node": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.15",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
